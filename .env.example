# ==============================================================================
# BENTA'S FUNERAL HOME (BFH OS) - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. TWILIO TELECOM & SMS GATEWAY
# ------------------------------------------------------------------------------
# Your Account SID (starts with AC...)
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token or API Secret (starts with SK...)
VITE_TWILIO_AUTH_TOKEN=your_auth_token_or_api_secret_here

# Your active Twilio phone number (E.164 e.g. +12122818850) or Messaging Service SID (MG...)
VITE_TWILIO_FROM_NUMBER=+12122818850


# 2. DOCUSIGN LEGAL E-SIGNATURES (NYS ESRA COMPLIANCE)
# ------------------------------------------------------------------------------
# VITE_DOCUSIGN_CLIENT_ID=your_docusign_integration_key
# VITE_DOCUSIGN_ACCOUNT_ID=your_docusign_account_id


# 3. INTUIT QUICKBOOKS ONLINE (FINANCIAL ACCOUNTING)
# ------------------------------------------------------------------------------
# VITE_QBO_CLIENT_ID=your_quickbooks_client_id
# VITE_QBO_REALM_ID=your_company_realm_id


# 4. STRIPE MERCHANT PAYMENTS & SPLIT-PAY
# ------------------------------------------------------------------------------
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
