# ==============================================================================
# BENTA'S FUNERAL HOME (BFH OS) - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. TWILIO TELECOM & SMS GATEWAY
# ------------------------------------------------------------------------------
# Your Account SID (starts with AC...)
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token or API Secret (starts with SK...)
# SECURITY: do NOT use a VITE_ prefix for secrets. Anything starting with VITE_ is bundled into the public website.
# Set the Twilio auth token as a SERVER-ONLY variable in Vercel (Project > Settings > Environment Variables): TWILIO_AUTH_TOKEN
# The serverless function api/twilio/sms.ts already reads TWILIO_AUTH_TOKEN. See docs/SECURITY_REMEDIATION.md.
# TWILIO_AUTH_TOKEN=your_auth_token_or_api_secret_here

# Your active Twilio phone number (E.164 e.g. +12122818850) or Messaging Service SID (MG...)
VITE_TWILIO_FROM_NUMBER=+12122818850


# 2. DOCUSIGN LEGAL E-SIGNATURES (NYS ESRA COMPLIANCE)
# ------------------------------------------------------------------------------
# VITE_DOCUSIGN_CLIENT_ID=your_docusign_integration_key
# VITE_DOCUSIGN_ACCOUNT_ID=your_docusign_account_id


# 3. INTUIT QUICKBOOKS ONLINE (FINANCIAL ACCOUNTING)
# ------------------------------------------------------------------------------
# VITE_QBO_CLIENT_ID=your_quickbooks_client_id
# VITE_QBO_REALM_ID=your_company_realm_id


# 4. STRIPE MERCHANT PAYMENTS & SPLIT-PAY
# ------------------------------------------------------------------------------
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# 10. DIGI TRIBUTE BACKEND (SERVER-ONLY, never VITE_)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...   # server secret. Never expose to the browser.
# TRIBUTE_PUBLIC_BASE_URL=https://tributes.e-bfh.com

# 11. STAFF SIGN-IN (Supabase Auth). Off by default. Public values only (publishable key), safe for VITE_.
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<publishable key>
